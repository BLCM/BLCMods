)","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.PrudentPrudence,SkillDescription,,After taking [skill]Melee Damage[-skill] or having your [skill]Shield[-skill] depleted after fully recharging, you gain improved [skill]Shield Recharge Rate[-skill], [skill]Shield Recharge Delay[-skill], [skill]Recoil Reduction[-skill], and [skill]Movement Speed[-skill] for [corrosive]8[-corrosive] seconds.","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.PrudentPrudence,SkillEffectDefinitions,,((AttributeToModify=AttributeDefinition'D_Attributes.GameplayAttributes.FootSpeed',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_None,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'Crocus_Baroness_Huntress.Misc.Att_PrudentPrudence_MoveSpeedPerLvl',InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'Crocus_Baroness_Huntress.Misc.Att_PrudentPrudence_MoveSpeedPerLvl',InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),(AttributeToModify=AttributeDefinition'D_Attributes.Weapon.WeaponReloadSpeed',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_None,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'Crocus_Baroness_Huntress.Misc.Att_PrudentPrudence_ReloadSpeedPerLvl',InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'Crocus_Baroness_Huntress.Misc.Att