							</hotfix>
						</category>
						<category name="Keep Your Chin Up">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_Servant.Skills.KeepYourChinUp SkillDescription While bound by a [skill]Contract[-skill] wherein you are the [skill]Master[-skill], kills made by you restore [skill]Max Health[-skill] to your [vacuum]Servant[-vacuum], and kills made by your [vacuum]Servant[-vacuum] restore [skill]Max Health[-skill] to you. [skill]Keep Your Chin Up[-skill] does not restore [skill]Max Health[-skill] if either party is in a vehicle.<br>Additionally, you and your [vacuum]Servant[-vacuum] gain increased [skill]Damage Resistance[-skill].</code>
								<code profiles="default">set Crocus_Baroness_Servant.Skills.KeepYourChinUp SkillEffectPresentations (AttributePresentationDefinition'Crocus_Baroness_Servant.Skills.KeepYourChinUp:AttributePresentationDefinition_1',AttributePresentationDefinition'Crocus_Baroness_Servant.Skills.ABackhandToRemember:AttributePresentationDefinition_0')</code>
