						<category name="Save The Queen">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_Servant.Skills.SaveTheQueen SkillDescription <font size="15">Whenever you receive [skill]Melee Damage[-skill], the attacking enemy becomes marked with [skill]Save the Queen[-skill]. If your [vacuum]Servant[-vacuum] damages a marked enemy, that enemy suffers <font color="#5ff5ff">Cryo</font> [skill]Status Effect Damage[-skill] and the mark is consumed. This can only occur once every [corrosive]3[-corrosive] seconds.<br>Additionally, you gain further increased [skill]Status Effect Damage[-skill] as well as additional [skill]Movement Speed[-skill] for each [skill]Duchess[-skill] stack.</font></code>
								<code profiles="default">set Crocus_Baroness_Servant.Skills.SaveTheQueen SkillEffectPresentations (AttributePresentationDefinition'Crocus_Baroness_Servant.Skills.SaveTheQueen:AttributePresentationDefinition_1',AttributePresentationDefinition'Crocus_Baroness_Servant.Skills.Valet:AttributePresentationDefinition_1',AttributePresentationDefinition'Crocus_Baroness_Servant.Skills.Valet:AttributePresentationDefinition_0')</code>
