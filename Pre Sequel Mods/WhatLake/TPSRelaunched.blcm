set GD_Cork_Weap_Pistol.Name.Title_Hyperion.Title__Unique_LadyFist:AttributePresentationDefinition_8 NoConstraintText <font size="13">True love is a Lady Fist. This is a Lady Palm.<br><font color="#ffb400">[funstat]+25% Critical Hit Damage and greatly increased Projectile Speed. While Aiming Down Sights, fires a wider spread of 6 slower-travelling bullets for 2 ammo.</font></font>
