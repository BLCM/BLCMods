						<category name="Absorb Shields ">
							<code profiles="default">set GD_Shields.A_Item.Shield_Absorption:AttributePresentationDefinition_1 Description <font size="14">When [skill]Absorbed[-skill], projectile damage is entirely mitgated and 1 ammo of the projectile's type is added to your [skill]reserves[-skill].</font></code>
							<code profiles="default">set GD_Shields.A_Item.Shield_Absorption:AttributePresentationDefinition_2 Description <font size="14"><font color="#9f99ff">Vladof Reallocation:</font> Chance to [skill]Absorb[-skill] enemy [skill]Bullets, Lasers[-skill], and both enemy and self-inflicted [skill]Rocket Damage[-skill].</font></code>
							<code profiles="default">set GD_Shields.A_Item.Shield_Absorption_05_LegendaryShock:AttributePresentationDefinition_1 Description <font size="14">When [skill]Absorbed[-skill], projectile damage is entirely mitgated and 1 ammo of the projectile's type is added to your [skill]reserves[-skill].</font></code>
							<code profiles="default">set GD_Shields.A_Item.Shield_Absorption_05_LegendaryShock:AttributePresentationDefinition_2 Description <font size="14"><font color="#9f99ff">Vladof Redistribution:</font> Chance to [skill]Absorb[-skill] enemy [skill]Bullets, Lasers[-skill], and both enemy and self-inflicted [skill]Rocket Damage[-skill].</font></code>
