set GD_MoonItems.Body.Body_Juggernaut:AttributePresentationDefinition_0 Description <font size="14"><font color="#9f99ff">Torgue Girth:</font> Increased [skill]Slam Damage[-skill], and grants [skill]Damage Resistance[-skill] to randomly rolled [skill]Elements[-skill].
set GD_MoonItems.Body.Body_Juggernaut:AttributePresentationDefinition_2 Description <font size="14">[skill]Slam[-skill] damage [skill]Shatters[-skill] enemy air masks.<br>[funstat][skill]Slamming[-skill] after falling a sufficient distance will deal [skill]Rocket Damage[-skill] in an area, staggering [skill]non-Boss enemies[-skill].</font>
