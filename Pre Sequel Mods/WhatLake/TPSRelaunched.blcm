0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),(AttributeToModify=AttributeDefinition'D_Attributes.SkillAttributes.IsSkillListeningForMeleeOverrideEvent',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_PostAdd,BaseModifierValue=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=))","Crocus_Baroness_Streaming,Crocus_Baroness_Servant.Skills.ContractualObligations,SkillDescription,,<font size=\"15\">Hold <StringAliasMap:Action.Melee> to [skill]present a Contract[-skill] to allies. If an ally accespts the [skill]Contract[-skill] via [skill]Melee Attack[-skill], then they become your [vacuum]Servant[-vacuum] and you, their [atmos]Master[-atmos]. You deal increased [skill]Gun Damage[-skill] and your [vacuum]Servant[-vacuum] gains increased [skill]Max Health[-skill] while your [skill]Contract[-skill] is active.<br><br>This [skill]Contract[-skill] is terminated only upon the death of either party. You may only be involved in a single [skill]Contract[-skill] at a time, and may not offer a new [skill]Contract[-skill] while bound by a pre-existing [skill]Contract[-skill].</font>","Crocus_Baroness_Streaming,Crocus_Baroness_Servant.Skills.ContractualObligations:AttributePresentationDefinition_0,Description,,[vacuum]Servant[-vacuum] Max Health: $NUMBER$","Crocus_Baroness_Streaming,Crocus_Baroness_Servant.Skills.ContractualObligations_Servant,SkillEffectDefinitions,,((AttributeToModify=ResourcePoolAttributeDefinition'D_Attributes.HealthResourcePool.HealthMaxValue',bIncludeDuelingTargets=