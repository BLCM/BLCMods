set GD_MoonItems.Body.Body_Astrotech:AttributePresentationDefinition_1 Description <font size="14">Beep boop beep.</font>
set GD_MoonItems.Body.Body_Astrotech:AttributePresentationDefinition_0 Description <font size="14"><font color="#ffb400">Sentient module has a 15% chance to rapidly restore Shields when under 20% Max Shields, which can occur once every 30 seconds.</font></font>
set GD_MoonItems.Body.Body_Astrotech:AttributePresentationDefinition_4 Description <font size="14"><font color="#ffb400">3DD13 also has a 15% chance to fully replenish O[small]2[-small] when under 20% O[small]2[-small], which can occur once every 30 seconds.</font></font>
set GD_MoonItems.Body.Body_Astrotech:AttributePresentationDefinition_2 Description <font size="14"><font color="#ffb400">Additionally, gain a 15% chance to spawn ammo and health pickups on kill with no cooldown.</font></font>
