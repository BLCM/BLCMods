						<category name="General">
							<hotfix name="Claptrap" package="GD_Prototype_Streaming">
								<code profiles="default">set GD_Prototype_Skills_GBX.ActionSkill.Skill_VaultHunterEXE:AttributePresentationDefinition_2 Description Cooldown: $NUMBER$ seconds</code>
								<code profiles="default">set GD_Prototype_Skills_GBX.ActionSkill.Skill_VaultHunterEXE:AttributePresentationDefinition_3 Description Regenerates $NUMBER$ of your Max Health / sec while most Action Packages are active</code>
								<code profiles="default">set GD_Prototype_Skills.Misc.Cooldown_QCS BaseValue (BaseValueConstant=35.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
								<code profiles="default">set GD_Prototype_Skills_GBX.ActionSkill.Skill_VaultHunterEXE SkillDescription <font size="14">[skill]Action Skill.[-skill] Press <StringAliasMap:Action.ActionSkill> to run your [skill]VaultHunter.EXE[-skill] program. It will analyze the situation, determine which "Vault Hunter" would do the best job, and then load an <font color="#ff6600">ACTION PACKAGE</font> allowing you to fight in that manner for a duration. It also fully restores your [skill]Max Health[-skill] and grants [skill]Max Health Regeneration[-skill]; for [skill]Action Packages[-skill] that do not summon a [skill]Minion[-skill], you also receive [skill]Damage Resistance[-skill].<br>[useful]Warning:[-useful] [skill]VaultHunter.EXE[-skill] is currently classified as malware, and as such, your allies may be affected. </font></code>
