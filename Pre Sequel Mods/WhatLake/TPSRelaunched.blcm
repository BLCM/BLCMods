er'","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.OneLastThing:AttributePresentationDefinition_0,Description,,<font size=\"15\">\"Money Shot\" Bonus: $NUMBER$</font>","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.OneLastThing:AttributePresentationDefinition_1,Description,,<font size=\"15\">Magazine Size for Full Bonus: $NUMBER$</font>","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.OneLastThing,SkillDescription,,<font size=\"14\">Deal increased [skill]Gun Damage[-skill]. Additionally, the [skill]last round[-skill] fired from most weapon's magazines, and the [skill]second to last round[-skill] fired from [skill]most weapons that cannot land Critical Hits[-skill], is a [skill]\"Money Shot\"[-skill], which deals further increased [skill]Gun Damage[-skill].<br><br>There is a minimum [skill]Magazine Size[-skill] required for the full bonus, and the damage bonus decreases by [corrosive]10%[-corrosive] of its total value for each ammo under this minumum. This skill does not provide any benefit if the equipped weapon has a [skill]Magazine Size[-skill] of [corrosive]1[-corrosive] or lower.</font>","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.OneLastThing,SkillEffectPresentations,,(AttributePresentationDefinition'GD_Prototype_Skills.Fragmented.AllTheGuns:AttributePresentationDefinition_3',AttributePresentationDefinition'GD_Prototype_Skills.Boomtrap.OneLastThing:AttributePresentationDefinition_0',AttributePresentationDefinition'GD_Prototype_Skills.Boomtrap.OneLastThing:AttributePresentationDefinition_1',)","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.OneLastThing,SkillEffectDefinitions,,((AttributeToModify=AttributeDefinition'D_Attributes.Weapon.WeaponDamage',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.0500000,BaseValueAttribut