ne,InitializationDefinition=None,BaseValueScaleConstant=0.45000000)","GD_Prototype_Streaming,GD_Prototype_Skills.Misc.Boomtrap.Att_SecondWindByTediore_ProjectileDamage,BaseValue,,(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)","GD_Prototype_Streaming,GD_Prototype_Skills.Projectiles.Projectile_SpawnSecondWindClone:BehaviorProviderDefinition_0.Behavior_Delay_15635,Delay,,0.50000","GD_Prototype_Streaming,GD_Prototype_Dummy.AI.AIDef_Prototype_SecondWindClone:AIBehaviorProviderDefinition_1.Behavior_Explode_2,DamageSource,,Class'WillowGame.WillowDmgSource_Grenade'","GD_Prototype_Streaming,GD_Prototype_Dummy.AI.AIDef_Prototype_SecondWindClone:AIBehaviorProviderDefinition_1.Behavior_Explode_2,DamageFormula,,(BaseValueConstant=750.499672,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)","GD_Prototype_Streaming,GD_Prototype_Dummy.AI.AIDef_Prototype_SecondWindClone:AIBehaviorProviderDefinition_1.Behavior_Explode_2,DamageRadiusFormula,,(BaseValueConstant=750.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.HyperionPunch:AttributePresentationDefinition_5,Description,,<font size=\"15\">Rank $NUMBER$ Damage</font>","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.HyperionPunch:AttributePresentationDefinition_0,Description,,<font size=\"15\">Max Stacks: $NUMBER$</font>","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.HyperionPunch,SkillDescription,,<font size=\"15\">[skill]Melee Override[-skill]. Dealing [skill][explosive]Explosive[-explosive] Damage[-skill] grants you stacks of [skill]Hyperion Punch[-skill]; at max stacks, pressing <StringAliasMap:Action.Melee> launches a homing fist that deals [skill][explosive]Explosive[-explosive] Melee Damage[-skill]. This consumes all stacks of [skill]Hyperion Punch[-skill], and while hits with it can grant stacks, there is a roughly [corrosive]5[-corrosive] second delay before a [skill]Hyperion Punch[-skill] can be thrown again. This delay is unaffected by [skill]Melee Override Cooldown Rate[-skill] bonuses.<br>Additionally, deal increased [skill]Melee Damage[-skill].</font>","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.HyperionPunch:AttributeExpressionEvaluator_0,Expression,,(AttributeOperand1=DesignerAttributeDefinition'GD_Prototype_Skills.Misc.Boomtrap.Att_HyperionPunch_HyperionPunchStacks',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=5.000000)","GD_Prototype_Streaming,GD_Prototype_Skills.Boomtrap.HyperionPunch_Active:AttributeExpressionEvaluator_0,Expression,,(AttributeOperand1=DesignerAttributeDefinition'GD_Prototype_Skills.Misc.Boomtrap.Att_HyperionPunch_HyperionPunchStacks',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=5.000000)","GD_Prototype_Streaming,GD_Prototype_Skills.Projectiles.Projectile_HyperionPunch:BehaviorProviderDefinition_0.Behavior_Explode_4,DamageSource,,Class'WillowGame.WillowDmgSource_Melee'","GD_Prototype_Streaming,GD_Prototype_Skills.Projectiles.Projectile_HyperionPunch:BehaviorProviderDefinition_0.Behavior_Explode_4,DamageFormula,,(BaseValueConstant=1000.511475,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=.5000000)","GD_Prototype_Streaming,GD_Prototype_Skills.Projectiles.Projectile_HyperionPunch:BehaviorProviderDefinition_0.Behavior_Explode_4,Definition,,GD_Explosions.explosive.Explosion_ExplosiveMaster","GD_Prototype_Streaming,GD_Prototype_Skills.explosive.Explosion_HyperionPunch,ExplosionScale,,((ExplosionPSTemplate=ParticleSystem'FX_CO_Prototype.Particles.Part_Prototype_HyperionPunch',MinRadius=0,MaxRadius=64,MinParticleScale=1.000000,MaxParticleScale=1.000000,ExplosionAkEvent=AkEvent'Ake_Cork_FX_Player_Fragtrap.Skills.Skill_Tree.Boomtrap.Ak_Play_Cork_FX_Fragtrap_Ask