,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Gladiator_Skills.Misc.Att_PrepareForGlory_TotalDamage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=0,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=0.000000),BonusUpgradeList=),)","GD_Gladiator_Streaming,GD_Gladiator_Skills.Phalanx.PrepareForGlory:AttributePresentationDefinition_3,Description,,Damage Dealt: $NUMBER$ per stack<br>Action Skill Cooldown Rate: $NUMBER$ per stack","GD_Gladiator_Streaming,GD_Gladiator_Skills.Phalanx.PrepareForGlory,SkillDescription,,<font size=\"15\">Activating the [skill]Aspis[-skill] taunts nearby enemies, making them more likely to attack you, and you gain a stacking bonus to [skill]Damage Dealt[-skill] for each [skill]individual enemy[-skill] that inflicts damage on your [skill]Aspis[-skill].<br>Stacks last for the entirety of your [skill]Aspis Duration[-skill] and up to [corrosive]5[-corrosive] seconds it has been thrown, where they then provide [skill]Action Skill Cooldown Rate[-skill] per stack.</font>","GD_Gladiator_Streaming,GD_Gladiator_Skills.Phalanx.PrepareForGlory:AttributePresentationDefinition_3,RoundingMode,,ATTRROUNDING_Float","GD_Gladiator_Streaming,GD_Gladiator_Skills.Phalanx.PrepareForGlory:AttributePresentationDefinition_3,bDisplayPercentAsFloat,,True","GD_Gladiator_Streaming,GD_Gladiator_Skills.Phalanx.PrepareForGlory:AttributePresentationDefinition_3,FloatPrecision,,0","GD_Gladiator_Streaming,GD_Gladiator_Skills.Phalanx.PrepareForGlory,SkillEffectPresentations,,(AttributePresentationDefinition'GD_Gladiator_Skills.Phalanx.PrepareForGlory:AttributePresentationDefinition_3',AttributePresentationDefinition'GD_Gladiator_Skills.CeraunicStorm.GatheringTempest:AttributePresentationDefinition_0')","GD_Gladiator_Streaming,GD_Gladiator_Skills.Phalanx.User,SkillDescription,,Allows the [skill]Aspis[-skill] to [skill]ricochet[-skill] to up to [skill][corrosive]4[-corrosive] additional enemies[-skill], each taking less damage than the last. The [skill]Aspis[-skill] will return to you after it hits the final enemy.<br>Additionally, gain increased [skill]Action Skill Cooldown Rate[-skill] and [skill]Max Health[-skill].","GD_Gladiator_Streaming,GD_Gladiator_Skills.Phalanx.User,SkillEffectDefinitions,,((AttributeToModify=None,bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_PreAdd,BaseModifierValue=(BaseValueConstant=0.330000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=0,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),(AttributeToModify=AttributeDefinition'D_Attributes.ActiveSkillCooldownResource.ActiveSkillCooldownConsumptionRate',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.1500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=0,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.00000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),(AttributeToModify=ResourcePoolAttributeDefinition'D_Attributes.HealthResourcePool.HealthMaxValue_Player',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,Modi