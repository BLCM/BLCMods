ion_2',AttributePresentationDefinition'Quince_Doppel_Hero.Skills.Inspire:AttributePresentationDefinition_10')","Quince_Doppel_Streaming,Quince_Doppel_Hero.Skills.Inspire:AttributePresentationDefinition_10,bDontDisplayNumber,,False","Quince_Doppel_Streaming,Quince_Doppel_Hero.Skills.Inspire:AttributePresentationDefinition_10,bUseCustomNumberPlacement,,True","Quince_Doppel_Streaming,Quince_Doppel_Hero.Skills.Inspire:AttributePresentationDefinition_10,Attribute,,AttributeDefinition'D_Attributes.Weapon.WeaponDamage'","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Teamwork,SkillDescription,,If an ally enters [skill]Fight For Your Life[-skill] or a [skill]Digi-Jack[-skill] dies, you receive a stack of [skill]Teamwork[-skill], granting [skill]Max Health Regeneration[-skill] for [corrosive]10[-corrosive] seconds. This effect can stack up to [corrosive]10[-corrosive] times, and stacks decay individually.","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Teamwork:AttributePresentationDefinition_7,Description,,Regenerates $NUMBER$ of your Max Health / sec per stack","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Misc.Att_Teamwork_RegenPerLevel:ConstantAttributeValueResolver_0,ConstantValue,,0.004000","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Commitment,SkillDescription,,<font size=\"15\">Whenever a [skill]Digi-Jack[-skill] dies or an ally enters [skill]Fight For Your Life[-skill], you gain a stack of [skill]Commitment[-skill], granting additional [skill]Fire Rate[-skill], [skill]Reload Speed[-skill], and [skill]Grenade Damage[-skill]. Stacks are also gained periodically as your allies remain in [skill]Fight For Your Life[-skill].<br>Stacks granted when a [skill]Digi-Jack[-skill] dies last for [corrosive]10[-corrosive] seconds, stacks gained from allies are quickly lost when they exit [skill]Fight For Your Life[-skill], and there is no stack limit.</font>","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Commitment:AttributePresentationDefinition_3,Description,,Fire Rate: $NUMBER$ per stack<br>Reload Speed: $NUMBER$ per stack","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Commitment:AttributePresentationDefinition_12,Description,,Grenade Damage: $NUMBER$ per stack","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Commitment:AttributePresentationDefinition_1,Description,,<br>\"Please don't interrupt me while I'm ignoring you.\"","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Misc.Att_Commitment_ReloadSpeedPerStack:ConstantAttributeValueResolver_0,ConstantValue,,0.0750000","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Misc.Att_Commitment_FireRatePerStack:ConstantAttributeValueResolver_0,ConstantValue,,-0.060000","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Commitment:BehaviorProviderDefinition_0.Behavior_Delay_1992,Delay,,10.000000","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Commitment,SkillEffectDefinitions,,((AttributeToModify=ResourcePoolAttributeDefinition'D_Attributes.AccuracyResourcePool.AccuracyActiveRegenerationRate',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_None,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'Quince_Doppel_GreaterGood.Misc.Att_Commitment_FireRatePerStack',InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),(AttributeToModify=ResourcePoolAttributeDefinition'D_Attributes.AccuracyResourcePool.AccuracyCurrentValue',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_None,TargetInstanceDataName=,TargetCrite