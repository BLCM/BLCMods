set GD_MoonItems.Body.Body_Acrobat:AttributePresentationDefinition_0 Description <font size="14"><font color="#9f99ff">Hyperion First-Class:</font> Increases your [skill]Air Control[-skill] and [skill]Melee Damage[-skill].</font>
set GD_MoonItems.Body.Body_Acrobat:AttributePresentationDefinition_1 Description <font size="14">Additionally, gain increased [skill]Movement Speed[-skill] for [corrosive]3[-corrosive] seconds after you [skill]Slam[-skill].<br>[funstat][skill]Slamming[-skill] after falling a sufficient distance will deal [skill]Rocket Damage[-skill] in an area, staggering [skill]non-Boss enemies[-skill].</font>
