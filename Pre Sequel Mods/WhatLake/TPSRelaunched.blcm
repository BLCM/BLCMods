						<category name="Custom Loads">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_1 Description Critical Nova Damage: Additional $NUMBER$ of Damage Dealt as Bullet Damage</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_2 Description Bonus Elemental Damage: $NUMBER$ of Damage Dealt as Bullet Damage<br></code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.CustomLoads SkillDescription While [skill]Aiming Down Sights[-skill] with a [skill]Sniper Rifle[-skill], a wheel scrolls through each of the Elements. Firing will add a [skill]Bonus Element[-skill] to any shots until you zoom out in the Element you landed on.<br>Additionally, [skill]Critical Hits[-skill] with an Element selected create small [skill]Novas[-skill]. Both the [skill]Bonus Element[-skill] and [skill]Nova[-skill] deal [skill]Elemental Bullet Damage[-skill] based on Damage Dealt.</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Misc.Att_CustomLoads_BonusDamage:ConstantAttributeValueResolver_0 ConstantValue 0.100000</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Misc.Att_CustomLoads_NovaDamage:ConstantAttributeValueResolver_0 ConstantValue 0.150000</code>
