						<category name="Skill Organization">
							<hotfix name="Claptrap" package="GD_Prototype_Streaming">
								<code profiles="default">set GD_Prototype_Skills.SkillTree.Branch_Fragmented Tiers ((Skills=(SkillDefinition'GD_Prototype_Skills.Fragmented.AllTheGuns',SkillDefinition'GD_Prototype_Skills.Fragmented.FuzzyLogic',SkillDefinition'GD_Prototype_Skills.Fragmented.SafetyFirst'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Prototype_Skills.Fragmented.FloatLikeABee',SkillDefinition'GD_Prototype_Skills.Fragmented.RopeADerp',SkillDefinition'GD_Prototype_Skills.ILoveYouGuys.WaxOffWaxOn'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Prototype_Skills.Fragmented.RainbowCoolant'),PointsToUnlockNextTier=1),(Skills=(SkillDefinition'GD_Prototype_Skills.Fragmented.GrenadeVent',SkillDefinition'GD_Prototype_Skills.Fragmented.ElementOfSurprise',SkillDefinition'GD_Prototype_Skills.ILoveYouGuys.ManiacalLaughter'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Prototype_Skills.Fragmented.DeathMachine',SkillDefinition'GD_Prototype_Skills.Fragmented.CryogenicExhaustManifold'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Prototype_Skills.Fragmented.Tripleclocked'),PointsToUnlockNextTier=0))</code>
