								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.Avalanche SkillDescription <font size="15">Dealing <font color="#5ff5ff">Cryo Damage</font> to an enemy grants you a stack of [skill]Avalanche[-skill]. You may only gain a single [skill]Avalanche[-skill] stack from each enemy, and each stack of [skill]Avalanche[-skill] grants a bonus to [skill]Elemental Damage[-skill] and [skill]Status Effect Chance[-skill], [useful]doubling[-useful] for <font color="#5ff5ff">Cryo Damage</font> and <font color="#5ff5ff">Freeze Chance</font>. [skill]Avalanche[-skill] stacks individually decay after [corrosive]10[-corrosive] seconds without dealing [ice]Cryo Damage[-ice], and decay rapidly upon entering [skill]Fight For Your Life[-skill].</font></code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.Avalanche DamageEvents ((EventType=SDE_DamagedEnemy,EventConstraints=((DamageTypeConstraint=WillowDamageTypeDefinition'GD_Ice.DamageType.DmgType_Ice_Impact',NotOfDamageTypeConstraints=,DamageSourceConstraint=None,bMustBeCriticalDamage=False,bMustBeOneShotKill=False),(DamageTypeConstraint=WillowDamageTypeDefinition'GD_Ice.DamageType.DmgType_Ice_Impact_NoFreeze',NotOfDamageTypeConstraints=,DamageSourceConstraint=None,bMustBeCriticalDamage=False,bMustBeOneShotKill=False)),EventName="DidCryoDamage"))</code>
