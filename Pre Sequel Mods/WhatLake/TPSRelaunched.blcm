						<category name="Winter's Fury">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.WintersFury SkillDescription Activating [skill]Cold as Ice[-skill] or manually changing your [skill]Shard's target[-skill] causes you to [skill]knock back[-skill] all nearby enemies.<br>This effect can only be triggered every [corrosive]3.5[-corrosive] seconds.</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.WintersFury_Cooldown InitialDuration 3.5000000</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.WintersFury:AttributePresentationDefinition_0 Description "Lit white snow on the mountain tonight."</code>
							</hotfix>
						</category>
						<category name="Bitter Riposte">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.BitterRiposte SkillDescription Taking damage from an enemy while your [skill]Shield is full[-skill] launches an <font color="#5ff5ff">Cryo</font> [skill]Dart[-skill] at that enemy, dealing <font color="#5ff5ff">Cryo</font> [skill]Bullet Damage[-skill] on impact.<br>Additionally, you deal increased [skill]Bullet Damage[-skill].</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.BitterRiposte:AttributePresentationDefinition_2 Description Ice Dart Damage: Rank $NUMBER$</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Projectiles.Projectile_BitterRiposte:BehaviorProviderDefinition_0.Behavior_Explode_2 DamageSource Class'WillowGame.WillowDmgSource_Bullet'</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Projectiles.Projectile_BitterRiposte:BehaviorProviderDefinition_0.Behavior_Explode_2 DamageFormula (BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Projectile.ProjectileDamage',InitializationDefinition=None,BaseValueScaleConstant=1.00000)</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Projectiles.Projectile_BitterRiposte:BehaviorProviderDefinition_0.Behavior_Explode_2 DamageRadiusFormula (BaseValueConstant=100.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.BitterRiposte SkillEffectDefinitions ((AttributeToModify=ResourcePoolAttributeDefinition'D_Attributes.AccuracyResourcePool.AccuracyMaxValue',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_None,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_PostAdd,BaseModifierValue=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),(AttributeToModify=AttributeDefinition'D_Attributes.DamageSourceModifiers.InstigatedBulletDamageModifier',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.020000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.020000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),)</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.BitterRiposte SkillEffectPresentations (AttributePresentationDefinition'Crocus_Baroness_ColdMoney.Skills.BitterRiposte:AttributePresentationDefinition_2',AttributePresentationDefinition'Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_0')</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_0 bDontDisplayNumber False</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_0 bUseCustomNumberPlacement True</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_0 Description Bullet Damage: $NUMBER$</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_0 Attribute AttributeDefinition'D_Attributes.DamageSourceModifiers.InstigatedBulletDamageModifier'</code>
							</hotfix>
						</category>
						<category name="Fragment Rain">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.FragmentRain SkillDescription When your [skill]Frost Shard[-skill] attaches to an enemy, it has a chance to spawn [corrosive]5[-corrosive] <font color="#5ff5ff">Ice</font> [skill]Fragments[-skill], which fly towards nearby enemies and deal <font color="#5ff5ff">Cryo</font> [skill]Melee Damage[-skill]. The first time your [skill]Frost Shard[-skill] attaches to an enemy after being thrown, it will always spawn <font color="#5ff5ff">Ice</font> [skill]Fragments[-skill].</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Projectiles.Projectile_FragmentRain_Child:BehaviorProviderDefinition_0.Behavior_Explode_8 DamageSource Class'WillowGame.WillowDmgSource_Melee'</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Misc.Att_FragmentRain_ShardChance:ConstantAttributeValueResolver_0 ConstantValue 0.50000</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.FragmentRain:AttributePresentationDefinition_1 Description Fragment Spawn Chance: $NUMBER$</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Misc.Att_FragmentRain_NumberOfShards:ConstantAttributeValueResolver_0 ConstantValue 5.000000</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.FragmentRain:BehaviorProviderDefinition_0.Behavior_SpawnProjectile_11 ChildProjectileBaseValues ((Attribute=AttributeDefinition'D_Attributes.Projectile.ProjectileDamage',BaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerSkillDamage',BaseValueScaleConstant=3.500000)),(Attribute=AttributeDefinition'D_Attributes.Projectile.ProjectileStatusEffectDamage',BaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerSkillStatusEffectDamage',BaseValueScaleConstant=0.5000000)),(Attribute=AttributeDefinition'D_Attributes.Projectile.ProjectileStatusEffectChanceModifier',BaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.StatusEffectModifiers.InstigatedIceStatusChanceModifier',InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
							</hotfix>
						</category>
						<category name="Frostbite">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.Frostbite SkillDescription Enemies damaged by your [skill]Frost Shard[-skill] or <font color="#5ff5ff">Ice</font> [skill]Fragments[-skill] are <font color="#5ff5ff">Frostbitten</font>, causing them to take increased <font color="#5ff5ff">Cryo Damage</font> for [corrosive]12[-corrosive] seconds.<br>Additionally, enemy Shields are disrupted while <font color="#5ff5ff">Frostbitten</font>, increasing <font color="#5ff5ff">Cryo Damage</font> dealt to [skill]Shields[-skill] even further.</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.Frostbite:AttributePresentationDefinition_1 Description Cryo Damage: $NUMBER$</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.Frostbite:AttributePresentationDefinition_0 Description Additional Cryo Damage Against Shields: $NUMBER$</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Misc.Att_Frostbite_DamageIncreasePerLevel:ConstantAttributeValueResolver_0 ConstantValue 0.060000</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Misc.Att_Frostbite_ShieldBonusPerLevel:ConstantAttributeValueResolver_0 ConstantValue 0.1800000</code>
							</hotfix>
						</category>
						<category name="Polar Vortex">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.PolarVortex SkillDescription Whenever your [skill]Frost Shard[-skill] attaches to an enemy, it has a chance to create a Singularity, [skill]pulling in nearby enemies[-skill]. The first time your [skill]Frost Shard[-skill] attaches to an enemy after being thrown, it will always create a Singularity.</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.PolarVortex:AttributePresentationDefinition_1 Description Singularity Chance: $NUMBER$</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.PolarVortex:AttributePresentationDefinition_0 Description "I don't mean to sound bitter, cold, or cruel, but I am, so that's how it comes out."</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Misc.Att_PolarVortex_SingularityChance:ConstantAttributeValueResolver_0 ConstantValue 0.50000</code>
							</hotfix>
						</category>
						<category name="Frigid Touch">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.FrigidTouch SkillDescription Gain [skill]Life Steal[-skill] from a portion of dealt <font color="#5ff5ff">Cryo Damage</font>.</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.FrigidTouch:AttributePresentationDefinition_2 Description Cryo Damage Life Steal: $NUMBER$</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.FrigidTouch:AttributePresentationDefinition_2 bDisplayPercentAsFloat False</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Misc.Att_FrigidTouch_LifeStealAmount:ConstantAttributeValueResolver_0 ConstantValue 0.010000</code>
								<code profiles="default">set Crocus_Baroness_ColdMoney.Skills.FrigidTouch SkillType SKILL_TYPE_Passive</code>
							</hotfix>
						</category>
						<category name="Whiteout">
