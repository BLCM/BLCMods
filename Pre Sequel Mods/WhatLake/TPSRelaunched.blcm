tionDefinition'Quince_Doppel_FreeEnterprise.Skills.CompoundInterest:AttributePresentationDefinition_2')","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.SkillTree.Branch_GreaterGood,Tiers,,((Skills=(SkillDefinition'Quince_Doppel_GreaterGood.Skills.Integrity',SkillDefinition'Quince_Doppel_GreaterGood.Skills.Collaborate'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'Quince_Doppel_GreaterGood.Skills.Synergy',SkillDefinition'Quince_Doppel_Hero.Skills.Inspire',SkillDefinition'Quince_Doppel_GreaterGood.Skills.Teamwork'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'Quince_Doppel_GreaterGood.Skills.Commitment'),PointsToUnlockNextTier=1),(Skills=(SkillDefinition'Quince_Doppel_GreaterGood.Skills.Believe',SkillDefinition'Quince_Doppel_GreaterGood.Skills.Accountability',SkillDefinition'Quince_Doppel_GreaterGood.Skills.Optimism'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'Quince_Doppel_GreaterGood.Skills.Winning',SkillDefinition'Quince_Doppel_GreaterGood.Skills.Potential',SkillDefinition'Quince_Doppel_GreaterGood.Skills.Delegation'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'Quince_Doppel_GreaterGood.Skills.Leadership'),PointsToUnlockNextTier=0))","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Integrity,SkillDescription,,You deal increased [skill]Gun Damage[-skill] against enemies who are below 40% [skill]Health[-skill]. If you have not damaged the enemy previously and the enemy is under 40% health, you deal even more [skill]Gun Damage[-skill].","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Integrity:AttributePresentationDefinition_0,Description,,Damage Bonus: $NUMBER$","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Integrity:AttributePresentationDefinition_6,Description,,Bonus Multiplier: $NUMBER$","Quince_Doppel_Streaming,Quince_Doppel_GreaterGood.Skills.Integrity,DamageEvents,,(EventType=SDE_DamagedEnemy,EventConstraints=((DamageTypeConstraint=None,NotOfDamageTypeConstraints=,DamageSourceConstraint=Class'WillowG