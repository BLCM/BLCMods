						<category name="Excellent Shot, Madam">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_Servant.Skills.ExcellentShotMadam SkillDescription <font size="15">Enemies damaged by your [vacuum]Servant[-vacuum] become [skill]Set Up[-skill]. Damaging an enemy who is [skill]Set Up[-skill] deals <font color="#5ff5ff">Cryo</font> [skill]Bullet Damage[-skill] to that enemy, consuming [skill]Set Up[-skill] in the process. You may only trigger [skill]Excellent Shot, Madam[-skill] once every [corrosive]3[-corrosive] seconds, and [skill]Set Up[-skill] cannot be applied nor consumed if either party is in a vehicle.<br>Additionally, you deal increased [skill]Bullet Damage[-skill] for each stack of [skill]Duchess[-skill].</font></code>
								<code profiles="default">set Crocus_Baroness_Servant.Skills.ExcellentShotMadam_Marked:BehaviorProviderDefinition_0.Behavior_CauseDamage_8 DamageSource Class'WillowGame.WillowDmgSource_Bullet'</code>
								<code profiles="default">set Crocus_Baroness_Servant.Skills.ExcellentShotMadam_Marked:BehaviorProviderDefinition_0.Behavior_CauseDamage_10 DamageSource Class'WillowGame.WillowDmgSource_Bullet'</code>
