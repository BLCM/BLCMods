				<category name="Guaranteed Phonic">
					<comment># Guaranteed Phonic v1.1.0</comment>
					<comment># by Apocalyptech</comment>
					<comment># Licensed under Public Domain / CC0 1.0 Universal</comment>
					<comment>#</comment>
					<comment># Guarantees the spawn of Phonic Kraggon (or Phuper Phonic Kraggon)</comment>
					<comment># in Serenity's Waste.</comment>
					<hotfix name="GuaranteedPhonic" level="Moonsurface_P">
						<code profiles="default">set Moonsurface_Combat.TheWorld:PersistentLevel.PopulationOpportunityDen_0 IsEnabled True</code>
					</hotfix>
				</category>
				<category name="No SpyBugs in The Cortex">
					<comment># No SpyBugs in The Cortex v1.0.0</comment>
					<comment># by Apocalyptech</comment>
					<comment># Licensed under Public Domain / CC0 1.0 Universal</comment>
					<comment>#</comment>
					<comment># Removes SpyBugs from The Cortex, so they won't spawn during Mutator arena matches</comment>
					<hotfix name="Name" level="Ma_SubBoss_P">
						<code profiles="default">set GD_Marigold_Pop_Bugs.Mixes.PopDef_Bugs_Mix_Mutator ActorArchetypeList[3].Probability (BaseValueConstant=0,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=0)</code>
					</hotfix>
				</category>
				<category name="Spawn Only COMs of your character">
					<comment># TPS No Wasted COMs v1.1.0</comment>
					<comment># by Apocalyptech</comment>
					<comment># Licensed under Public Domain / CC0 1.0 Universal</comment>
					<comment>#</comment>
					<comment># Sets the game to only drop COMs for the player classes who are actually</comment>
					<comment># in the game at the time.  Once a player class has joined the game, the</comment>
					<comment># only way to remove that character's COMs from the drop pools is to exit</comment>
					<comment># to the main menu and re-execute the patch.</comment>
					<category name="Initial Clear">
						<comment># Do an initial set to clear out the COM item pools.  This is actually</comment>
						<comment># only required if you're looking to "clear out" a pool after a character's</comment>
						<comment># left the game, and must be done by exiting out to the main menu and re-</comment>
