				</category>
			</category>
			<category name="Quality of Life / System Changes- Mine">
				<category name="Element Changes">
					<category name="Freeze ">
						<comment>Freeze Effects now only last 3 seconds, and the damage modifiers while Frozen have been reduced greatly. </comment>
						<comment>There is no longer a Critical Hit bonus, Explosive Damage is only increased by 1.25x, and Melee Damage is increased by 2.0x.</comment>
						<comment></comment>
						<comment>It's still pretty insane by itself, and the changes to global melee and skill trees lead to higher melee peaks than in vanilla for most characters.</comment>
						<code profiles="default">set GD_Ice.Skills.Skill_IceEffects SkillEffectDefinitions ((AttributeToModify=AttributeDefinition'D_Attributes.GameplayAttributes.FootSpeed',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=True,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=-1.0000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=0,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),(AttributeToModify=AttributeDefinition'D_Attributes.DamageSourceModifiers.ReceivedMeleeDamageModifier',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.5000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=0,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),(AttributeToModify=AttributeDefinition'D_Attributes.DamageTypeModifers.ExplosiveImpactDamageModifier',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=.25000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=0,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=))</code>
						<code profiles="default">set GD_Ice.StatusEffect.Status_Ice BaseDuration (BaseValueConstant=3.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
						<code profiles="default">set GD_Ice.DamageType.DmgType_Ice_Impact:AttributePresentationDefinition_5 Description <font size="13">Freezes enemies solid, causing them to take +25% Explosive Damage and +50% Melee Damage.</font></code>
						<code profiles="default">set GD_Ice.DamageType.DmgType_Ice_Impact:AttributePresentationDefinition_5 TextColor (B=255,G=210,R=0,A=255)</code>
					</category>
					<category name="Shock">
						<comment>Shock Damage is now only 90% effective against Flesh, and has its multiplier against Shields reduced from 2.0 and 2.5 for PT1 and PT2+ 1.75 and to 2.00.</comment>
						<comment></comment>
						<comment>However, its Status Effect lasts 3.5 seconds, up from 2.</comment>
						<code profiles="default">set GD_Shock.StatusEffect.Status_Shock BaseDuration (BaseValueConstant=3.50000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
						<code profiles="default">set GD_Shock.DamageType.DmgType_Shock_Impact:AttributePresentationDefinition_5 Description <font size="13">Highly effective vs Shields.</font></code>
						<code profiles="default">set GD_Shock.DamageType.DmgType_Shock_Impact_NoDoT:AttributePresentationDefinition_5 Description <font size="13">Highly effective vs Shields.</font></code>
						<code profiles="default">set GD_Shock.DamageType.DmgType_Shock_Impact FleshDamageModifier (BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'GD_Balance_HealthAndDamage.DamageMultipliers.Init_NormalElementResistMultiplier_ByPlaythrough',BaseValueScaleConstant=.8000000)</code>
						<code profiles="default">set GD_Shock.DamageType.DmgType_Shock_Impact_NoDoT FleshDamageModifier (BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'GD_Balance_HealthAndDamage.DamageMultipliers.Init_NormalElementResistMultiplier_ByPlaythrough',BaseValueScaleConstant=.8000000)</code>
						<code profiles="default">set GD_Balance_HealthAndDamage.DamageMultipliers.Init_ShockBonusDamageMultiplier_ByPlaythrough ConditionalInitialization ((bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=1.75000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=1.000000))),(BaseValueIfTrue=(BaseValueConstant=2.00000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=2.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
					</category>
					<category name="Incendiary">
						<code profiles="default">set GD_Incendiary.StatusEffect.Status_Incendiary BaseDuration (BaseValueConstant=7.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
						<code profiles="default">set GD_Incendiary.DamageType.DmgType_Incendiary_Impact:AttributePresentationDefinition_3 Description <font size="13">Highly effective vs Flesh.</font></code>
						<code profiles="default">set GD_Incendiary.DamageType.DmgType_Incendiary_Impact_NoDoT:AttributePresentationDefinition_3 Description <font size="13">Highly effective vs Flesh.</font></code>
					</category>
					<category name="Corrosive">
						<comment>Corrosive Damage now only receives a 30% penalty against Flesh in PT2+, rather than 40%.</comment>
						<comment></comment>
						<comment>Its Status Effect Duration was brought from 14 to 7 to be consistent with Incendiary, and improve the flow of skills that require fresh Status Effects.</comment>
						<code profiles="default">set GD_Corrosive.StatusEffect.Status_Corrosive BaseDuration (BaseValueConstant=7.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
						<code profiles="default">set GD_Corrosive.DamageType.DmgType_Corrosive_Impact:AttributePresentationDefinition_0 Description <font size="13">Highly effective vs Armor.</font></code>
						<code profiles="default">set GD_Corrosive.DamageType.DmgType_Corrosive_Impact_NoDot:AttributePresentationDefinition_0 Description <font size="13">Highly effective vs Armor.</font></code>
						<code profiles="default">set GD_Corrosive.DamageType.DmgType_Corrosive_Impact ConditionalInitialization ((bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.900000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=1.000000))),(BaseValueIfTrue=(BaseValueConstant=0.700000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=2.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
						<code profiles="default">set GD_Corrosive.DamageType.DmgType_Corrosive_Impact_NoDot ConditionalInitialization ((bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.900000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=1.000000))),(BaseValueIfTrue=(BaseValueConstant=0.700000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=2.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
					</category>
					<category name="Kinetic ">
						<comment>Kinetic (Non-Elemental) Damage now deals full damage against Armor, making it fully neutral against all enemy health types.</comment>
						<code profiles="default">set GD_Impact.DamageType.DmgType_Normal ArmorDamageModifier (BaseValueConstant=1.00000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
				</category>
				<category name="Kill Skill Durations 7 - 10 Seconds">
					<code profiles="default">set GD_Globals.General.Globals KillSkillDurationsPerPlayers ((Players=1,Duration=10.000000),(Players=2,Duration=10.000000),(Players=3,Duration=10.000000),(Players=4,Duration=10.000000))</code>
				</category>
				<category name="UVHM Modifiers ">
					<comment>Less focus has been placed on Badass foes in UVHM, with larger bonuses for non-Badass enemy health that slightly increase every 10 levels.</comment>
					<comment></comment>
					<comment>Additionally, being in UVHM increases Swap Speed and increases the damage of several damage types:</comment>
					<comment></comment>
					<comment>+20% Swap Speed </comment>
					<comment></comment>
					<comment>+150% Status Effect Damage </comment>
					<comment></comment>
					<comment>+125% Melee Damage </comment>
					<comment></comment>
					<comment>+50% Rocket Damage </comment>
					<comment></comment>
					<comment>+50% Nova and Spike Damage </comment>
					<comment>(which is largely vestigial since Shields no longer use them, but just in case)</comment>
					<code profiles="default">set MainGameRefs.Balance.BalanceMod_PT3 BalanceModifiers ((MinEffectiveLevel=50,EnemyHealthMultiplier=1.6250000000,BadassEnemyHealthMultiplier=1.50000000,EnemyShieldStrengthMultiplier=2.25000000,BadassEnemyShieldStrengthMultiplier=2.250000,EnemyDamageMultiplier=1.0500000,BadassEnemyDamageMultiplier=1.000000,XPGainedFromCombatMultiplier=1.00000,XPGainedFromQuestsMultiplier=1.200000,BadassRankGainMultiplier=2.5000000,AmplifiedDamageMultiplier=2.00000,PlayerVehicleWeaponDamageMultiplier=1.50000,AttributeEffectsForSpawnedEnemies=,AttributeEffectsForPlayers=((AttributeToModify=AttributeDefinition'D_Attributes.Weapon.WeaponSwapTimeMultiplier',ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=-0.200000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(AttributeToModify=AttributeDefinition'D_Attributes.DamageTypeModifers.InstigatedIncendiaryStatusDamageModifier',ModifierType=MT_PreAdd,BaseModifierValue=(BaseValueConstant=1.500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(AttributeToModify=AttributeDefinition'D_Attributes.DamageTypeModifers.InstigatedCorrosiveStatusDamageModifier',ModifierType=MT_PreAdd,BaseModifierValue=(BaseValueConstant=1.500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(AttributeToModify=AttributeDefinition'D_Attributes.DamageTypeModifers.InstigatedShockStatusDamageModifier',ModifierType=MT_PreAdd,BaseModifierValue=(BaseValueConstant=1.500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(AttributeToModify=AttributeDefinition'D_Attributes.DamageTypeModifers.InstigatedIceStatusDamageModifier',ModifierType=MT_PreAdd,BaseModifierValue=(BaseValueConstant=1.500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(AttributeToModify=AttributeDefinition'D_Attributes.DamageSourceModifiers.InstigatedMeleeDamageModifi