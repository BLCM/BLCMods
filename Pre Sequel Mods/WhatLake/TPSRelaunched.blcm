							</hotfix>
						</category>
						<category name="Magic Bullet">
							<hotfix name="Aurelia" package="Crocus_Baroness_Streaming">
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.MagicBullet:AttributePresentationDefinition_5 Description Health Regeneration: Up to $NUMBER$ of Max Health / sec.</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.MagicBullet:AttributePresentationDefinition_7 Description Healing Nova: Up to $NUMBER$ of Max Health</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.MagicBullet SkillDescription Landing a [skill]Critical Hit[-skill] with a [skill]Sniper Rifle[-skill] grants [skill]Max Health Regeneration[-skill] for [corrosive]10[-corrosive] seconds; the closer you are to the enemy, the larger the bonus.<br>Additionally, landing a [skill]Critical Hit[-skill] with a [skill]Sniper Rifle[-skill] creates a [skill]Healing Nova[-skill] centered on that enemy, healing and granting [skill]Second Winds[-skill] to nearby players. [skill]Healing Novas[-skill] restore more health the further you are from your target.</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.MagicBullet_Active SkillEffectDefinitions ((AttributeToModify=ResourcePoolAttributeDefinition'D_Attributes.HealthResourcePool.HealthPassiveRegenerationRate',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_PostAdd,BaseModifierValue=(BaseValueConstant=0.000000,BaseValueAttribute=ResourcePoolAttributeDefinition'D_Attributes.HealthResourcePool.HealthMaxValue_Player',InitializationDefinition=AttributeInitializationDefinition'Crocus_Baroness_Huntress.Misc.Init_MagicBullet_RegenAmount_Calc',BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=))</code>
								<code profiles="default">set Crocus_Baroness_Huntress.Skills.MagicBullet_Active InitialDuration 5.000000</code>
