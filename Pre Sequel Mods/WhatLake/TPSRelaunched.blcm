				<category name="Refill Ammo Vendors">
					<category name="Introduction">
						<comment>####################################################################################################</comment>
						<comment># By Jim Raven                                                                                     #</comment>
						<comment># Makes Ammo Vendors Refill your Ammo Fully!                                                       #</comment>
						<comment># Example you buy One Sniper Ammo from vendor when you have 0 ammo now you are full                #</comment>
						<comment># Install WIth Filter Tool Unless you know how to Merge hotfixes yourself                          #</comment>
						<comment># Everything is editable and categorised as such for an easier Customazability to your own needs.  #</comment>
						<comment>####################################################################################################</comment>
					</category>
					<category name="Assault Rifle">
						<hotfix name="RefillVendors" level="None">
							<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_CombatRifle:ConstantAttributeValueResolver_0 ConstantValue 9999.000000</code>
							<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Assault_Rifle_Bullets:AttributePresentationDefinition_0 Description Completely refills your Assault Rifle ammo.</code>
						</hotfix>
					</category>
					<category name="Grenades">
						<hotfix name="RefillVendors" level="None">
							<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Grenades:ConstantAttributeValueResolver_1 ConstantValue 9999.000000</code>
							<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Grenade_Protean:AttributePresentationDefinition_2 Description Completely refills your Grenade ammo.</code>
						</hotfix>
					</category>
					<category name="Lasers">
						<hotfix name="RefillVendors" level="None">
							<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Laser:ConstantAttributeValueResolver_5 ConstantValue 9999.000000</code>
							<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Laser_Cells:AttributePresentationDefinition_1 Description Completely refills your Laser ammo.</code>
						</hotfix>
					</category>
					<category name="Launchers">
						<hotfix name="RefillVendors" level="None">
							<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Launcher:ConstantAttributeValueResolver_2 ConstantValue 9999.000000</code>
							<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Rocket_Launcher:AttributePresentationDefinition_6 Description Completely refills Rocket Launcher ammo.</code>
						</hotfix>
					</category>
					<category name="Pistols">
						<hotfix name="RefillVendors" level="None">
							<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Repeater:ConstantAttributeValueResolver_4 ConstantValue 9999.000000</code>
							<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Repeater_Pistol_Clip:AttributePresentationDefinition_4 Description Completely refills your Pistol ammo.</code>
						</hotfix>
					</category>
					<category name="SMG">
						<hotfix name="RefillVendors" level="None">
							<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_SMG:ConstantAttributeValueResolver_3 ConstantValue 9999.000000</code>
							<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Patrol_SMG_Clip:AttributePresentationDefinition_3 Description Completely refills your SMG ammo.</code>
						</hotfix>
					</category>
					<category name="Shotgun">
						<hotfix name="RefillVendors" level="None">
							<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Shotgun:ConstantAttributeValueResolver_5 ConstantValue 9999.000000</code>
							<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Shotgun_Shells:AttributePresentationDefinition_1 Description Completely refills your Shotgun ammo.</code>
						</hotfix>
					</category>
					<category name="Sniper Rifle">
						<hotfix name="RefillVendors" level="None">
							<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_SniperRifle:ConstantAttributeValueResolver_6 ConstantValue 9999.000000</code>
							<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Sniper_Rifle_Cartridges:AttributePresentationDefinition_7 Description Completely refills your Sniper Rifle ammo.</code>
						</hotfix>
					</category>
				</category>
				<category name="Make Luneshines Appear in the Wild">
					<comment>Not Balanced as id have to edit EACH SINGLE Gun in the game in order to balance the rates they appear.</comment>
					<comment>As is will spawn more luneshined weapons than Non Luneshined weapons.</comment>
					<category name="Code">
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Boominator PartSubType WPS_Normal</code>
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_None PartSubType WPS_Normal</code>
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Serenity PartSubType WPS_Normal</code>
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_FastLearner PartSubType WPS_Normal</code>
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Punisher PartSubType WPS_Normal</code>
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_PiercingRounds PartSubType WPS_Normal</code>
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Oxygenator PartSubType WPS_Normal</code>
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Safeguard PartSubType WPS_Normal</code>
						<code profiles="">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_HardenUp PartSubType WPS_Normal</code>
					</category>
				</category>
				<category name="No Broken Chests Near Denial Subroutine">
					<comment># No Broken Chests Near Denial Subroutine v1.0.0</comment>
					<comment># by Apocalyptech</comment>
					<comment># Licensed under Public Domain / CC0 1.0 Universal</comment>
					<comment>#</comment>
					<comment># The Denial Subroutine arena (in Cluster 99002 0V3RL00K) has six bandit "coolers" which don't actually</comment>
					<comment># work -- they open and spawn their items, but the items can't actually be picked up.  This mod changes</comment>
					<comment># them to be the round ammo chests instead, so at least they work.</comment>
					<hotfix name="Name" level="Ma_RightCluster_P">
						<code profiles="default">set Ma_RightCluster_Combat.TheWorld:PersistentLevel.WillowPopulationOpportunityPoint_44 PopulationDef PopulationDefinition'GD_Ma_Population_Treasure.Lootables.BanditAmmo_Marigold'</code>
						<code profiles="default">set Ma_RightCluster_Combat.TheWorld:PersistentLevel.WillowPopulationOpportunityPoint_131 PopulationDef PopulationDefinition'GD_Ma_Population_Treasure.Lootables.BanditAmmo_Marigold'</code>
						<code profiles="default">set Ma_RightCluster_Combat.TheWorld:PersistentLevel.WillowPopulationOpportunityPoint_145 PopulationDef PopulationDefinition'GD_Ma_Population_Treasure.Lootables.BanditAmmo_Marigold'</code>
						<code profiles="default">set Ma_RightCluster_Combat.TheWorld:PersistentLevel.WillowPopulationOpportunityPoint_147 PopulationDef PopulationDefinition'GD_Ma_Population_Treasure.Lootables.BanditAmmo_Marigold'</code>
						<code profiles="default">set Ma_RightCluster_Combat.TheWorld:PersistentLevel.WillowPopulationOpportunityPoint_148 PopulationDef PopulationDefinition'GD_Ma_Population_Treasure.Lootables.BanditAmmo_Marigold'</code>
						<code profiles="default">set Ma_RightCluster_Combat.TheWorld:PersistentLevel.WillowPopulationOpportunityPoint_149 PopulationDef PopulationDefinition'GD_Ma_Population_Treasure.Lootables.BanditAmmo_Marigold'</code>
					</hotfix>
				</category>
				<category name="Guaranteed M0RQ, Cutie Killer, and Heartfull Splodger">
					<comment># Guaranteed M0RQ, Cutie Killer, and Heartfull Splodger v1.0.0</comment>
					<comment># by Apocalyptech</comment>
					<comment># Licensed under Public Domain / CC0 1.0 Universal</comment>
					<comment>#</comment>
					<comment># Ensures that the unique chests holding the M0RQ, Cutie Killer, and Heartfull Splodger</comment>
					<comment># will be openable -- avoids the glitch where sometimes a playthrough of Claptastic</comment>
					<comment># Voyage will have the chest already open, and the item therefore unobtainable.  This</comment>
					<comment># does lead to a side effect where these chests will be available again each time</comment>
					<comment># Borderlands is restarted.</comment>
					<category name="M0RQ, in Motherlessboard">
						<hotfix name="Name" level="Ma_Motherboard_P">
							<code profiles="default">set GD_Ma_Population_Treasure.InteractiveObjects.InteractiveObj_HiddenStash_03:BehaviorProviderDefinition_0 BehaviorSequences[0].EventData2[0].OutputLinks.ArrayIndexAndLength 262145</code>
						</hotfix>
					</category>
					<category name="Cutie Killer, in Subconscious">
						<hotfix name="Name" level="Ma_Subconscious_P">
							<code profiles="default">set GD_Ma_Population_Treasure.InteractiveObjects.InteractiveObj_HiddenStash_01:BehaviorProviderDefinition_0 BehaviorSequences[0].EventData2[0].OutputLinks.ArrayIndexAndLength 589825</code>
						</hotfix>
					</category>
					<category name="Heartfull Splodger, in Cluster 99002 0V3RL00K">
						<hotfix name="Name" level="Ma_RightCluster_P">
							<code profiles="default">set GD_Ma_Population_Treasure.InteractiveObjects.InteractiveObj_HiddenStash_02:BehaviorProviderDefinition_0 BehaviorSequences[0].EventData2[0].OutputLinks.ArrayIndexAndLength 393217</code>
						</hotfix>
					</category>
				</category>
				<category name="Early game has more gun types">
					<comment>### More stuff drop in early levels. Shields Grenades and all rarities of them are avaliable as soon as that type starts appearing not only after lv7</comment>
					<comment>####################################### 		LV1			###########################################</comment>
					<code profiles="default">set GD_Itempools.Scheduling.Gamestage_02:ConstantAttributeValueResolver_0 ConstantValue 1</code>
					<comment>##### 		 SMGS</comment>
