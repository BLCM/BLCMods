ming,Crocus_Baroness_ColdMoney.Misc.Att_FragmentRain_ShardChance:ConstantAttributeValueResolver_0,ConstantValue,,0.50000","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.FragmentRain:AttributePresentationDefinition_1,Description,,Fragment Spawn Chance: $NUMBER$","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Misc.Att_FragmentRain_NumberOfShards:ConstantAttributeValueResolver_0,ConstantValue,,5.000000","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.FragmentRain:BehaviorProviderDefinition_0.Behavior_SpawnProjectile_11,ChildProjectileBaseValues,,((Attribute=AttributeDefinition'D_Attributes.Projectile.ProjectileDamage',BaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerSkillDamage',BaseValueScaleConstant=3.500000)),(Attribute=AttributeDefinition'D_Attributes.Projectile.ProjectileStatusEffectDamage',BaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerSkillStatusEffectDamage',BaseValueScaleConstant=0.5000000)),(Attribute=AttributeDefinition'D_Attributes.Projectile.ProjectileStatusEffectChanceModifier',BaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.StatusEffectModifiers.InstigatedIceStatusChanceModifier',InitializationDefinition=None,BaseValueScaleConstant=1.000000)))","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.Frostbite,SkillDescription,,Enemies damaged by your [skill]Frost Shard[-skill] or <font color=\"#5ff5ff\">Ice</font> [skill]Fragments[-skill] are <font color=\"#5ff5ff\">Frostbitten</font>, causing them to take increased <font color=\"#5ff5ff\">Cryo Damage</font> for [corrosive]12[-corrosive] seconds.<br>Additionally, enemy Shields are disrupted while <font color=\"#5ff5ff\">Frostbitten</font>, increasing <font color=\"#5ff5ff\">Cryo Damage</font> dealt to [skill]Shields[-skill] even further.","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.Frostbite:AttributePresentationDefinition_1,Description,,Cryo Damage: $NUMBER$","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.Frostbite:AttributePresentationDefinition_0,Description,,Additional Cryo Damage Against Shields: $NUMBER$","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Misc.Att_Frostbite_DamageIncreasePerLevel:ConstantAttributeValueResolver_0,ConstantValue,,0.060000","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Misc.Att_Frostbite_ShieldBonusPerLevel:ConstantAttributeValueResolver_0,ConstantValue,,0.1800000","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.PolarVortex,SkillDescription,,Whenever your [skill]Frost Shard[-skill] attaches to an enemy, it has a chance to create a Singularity, [skill]pulling in nearby enemies[-skill]. The first time your [skill]Frost Shard[-skill] attaches to an enemy after being thrown, it will always create a Singularity.","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.PolarVortex:AttributePresentationDefinition_1,Description,,Singularity Chance: $NUMBER$","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.PolarVortex:AttributePresentationDefinition_0,Description,,\"I don't mean to sound bitter, cold, or cruel, but I am, so that's how it comes out.\"","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Misc.Att_PolarVortex_SingularityChance:ConstantAttributeValueResolver_0,ConstantValue,,0.50000","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.FrigidTouch,SkillDescription,,Gain [skill]Life Steal[-skill] from a portion of dealt <font color=\"#5ff5ff\">Cryo Damage</font>.","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.FrigidTouch:AttributePresentationDefinition_2,Description,,Cryo Damage Life Steal: $NUMBER$","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.FrigidTouch:AttributePresentationDefinition_2,bDisplayPer