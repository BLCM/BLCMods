alueScaleConstant=-1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=),)","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Misc.Att_PrudentPrudence_MoveSpeedPerLvl:ConstantAttributeValueResolver_0,ConstantValue,,-0.070000","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Misc.Att_PrudentPrudence_ReloadSpeedPerLvl:ConstantAttributeValueResolver_0,ConstantValue,,0.1200000","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Misc.Att_PrudentPrudence_WeaponDamagePerLvl:ConstantAttributeValueResolver_0,ConstantValue,,0.070000","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.PrudentPrudence,DamageEvents,,(EventType=SDE_DamagedByEnemy,EventConstraints=((DamageTypeConstraint=None,NotOfDamageTypeConstraints=,DamageSourceConstraint=Class'WillowGame.WillowDmgSource_Melee',bMustBeCriticalDamage=False,bMustBeOneShotKill=False)),EventName=\"DamagedByMelee\")","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.PrudentPrudence_Active,InitialDuration,,8.000000","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.PrudentPrudence:AttributePresentationDefinition_8,bDontDisplayPlusSign,,True","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_1,Description,,Critical Nova Damage: Additional $NUMBER$ of Damage Dealt as Bullet Damage","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.CustomLoads:AttributePresentationDefinition_2,Description,,Bonus Elemental Damage: $NUMBER$ of Damage Dealt as Bullet Damage<br>","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.CustomLoads,SkillDescription,,While [skill]Aiming Down Sights[-skill] with a [skill]Sniper Rifle[-skill], a wheel scrolls through each of the Elements. Firing will add a [skill]Bonus Element[-skill] to any shots until you zoom out in the Element you landed on.<br>Additionally, [skill]Critical Hits[-skill] with an Element selected create small [skill]Novas[-skill]. Both the [skill]Bonus Element[-skill] and [skill]Nova[-skill] deal [skill]Elemental Bullet Damage[-skill] based on Damage Dealt.","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Misc.Att_CustomLoads_BonusDamage:ConstantAttributeValueResolver_0,ConstantValue,,0.100000","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Misc.Att_CustomLoads_NovaDamage:ConstantAttributeValueResolver_0,ConstantValue,,0.150000","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.CustomLoads:BehaviorProviderDefinition_0.Behavior_Explode_89,DamageSource,,Class'WillowGame.WillowDmgSource_Bullet'","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.CustomLoads:BehaviorProviderDefinition_0.Behavior_Explode_89,StatusEffectDamage,,(BaseValueConstant=1.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Weapon.WeaponStatusEffectDamage',InitializationDefinition=None,BaseValueScaleConstant=1.000000)","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.CustomLoads:BehaviorProviderDefinition_0.Behavior_Explode_89,StatusEffectChance,,(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.MagicBullet:AttributePresentationDefinition_5,Description,,Health Regeneration: Up to $NUMBER$ of Max Health / sec.","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.MagicBullet:AttributePresentationDefinition_7,Description,,Healing Nova: Up to $NUMBER$ of Max Health","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.MagicBullet,SkillDescription,,Landing a [skill]Critical Hit[-skill] with a [skill]Sniper Rifle[-skill] grants [skill]Max Health Regeneration[-skill] for [corrosive]10[-corrosive] seconds; the closer you are to the enemy, the larger the bonus.<br>Additionally, landing a [skill]Critical Hit[-skill] with a [skill]Sniper Rifle[-skill] creates a [skill]Healing Nova[-skill] centered on that enemy, healing and granting [skill]Second Winds[-skill] to nearby players. [skill]Healing Novas[-skill] restore more health the further you are from your target.","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.MagicBullet_Active,SkillEffectDefinitions,,((AttributeToModify=ResourcePoolAttributeDefinition'D_Attributes.HealthResourcePool.HealthPassiveRegenerationRate',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_PostAdd,BaseModifierValue=(BaseValueConstant=0.000000,BaseValueAttribute=ResourcePoolAttributeDefinition'D_Attributes.HealthResourcePool.HealthMaxValue_Player',InitializationDefinition=AttributeInitializationDefinition'Crocus_Baroness_Huntress.Misc.Init_MagicBullet_RegenAmount_Calc',BaseValueScaleConstant=1.000000),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),BonusUpgradeList=))","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.MagicBullet_Active,InitialDuration,,5.000000","Crocus_Baroness_Streaming,Crocus_Baroness_Huntress.Skills.MagicBullet,SkillConstraints,,(bApplyConstraintOnActivatation=True,bApplyConstraintWhileActive=True,bApplyConstraintWhilePaused=True,OnFailure=SKILL_Paused,Evaluator=None,EvaluatorDefinitions=(SkillExpressionEvaluatorDefinition'GD_PlayerShared.SkillConstraints.SkillConstraint_OnFootOrRidingInBack'))","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.SkillTree.Branch_ColdMoney,Tiers,,((Skills=(SkillDefinition'Crocus_Baroness_ColdMoney.Skills.ShortSummer',SkillDefinition'Crocus_Baroness_ColdMoney.Skills.WintersVeil'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'Crocus_Baroness_ColdMoney.Skills.Avalanche',SkillDefinition'Crocus_Baroness_ColdMoney.Skills.WintersFury',SkillDefinition'Crocus_Baroness_ColdMoney.Skills.BitterRiposte'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'Crocus_Baroness_ColdMoney.Skills.FragmentRain'),PointsToUnlockNextTier=1),(Skills=(SkillDefinition'Crocus_Baroness_ColdMoney.Skills.Whiteout',SkillDefinition'Crocus_Baroness_ColdMoney.Skills.PolarVortex',SkillDefinition'Crocus_Baroness_ColdMoney.Skills.FrigidTouch'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'Crocus_Baroness_ColdMoney.Skills.Frostbite',SkillDefinition'Crocus_Baroness_ColdMoney.Skills.ColdAdvance'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'Crocus_Baroness_ColdMoney.Skills.Wintertide'),PointsToUnlockNextTier=0))","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.ShortSummer:AttributePresentationDefinition_0,Description,,Shield Recharge Delay: $NUMBER$ per stack","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.ShortSummer:AttributePresentationDefinition_3,Description,,Cooldown Rate: $NUMBER$ per stack","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.ShortSummer:AttributePresentationDefinition_5,Description,,Max Stacks: $NUMBER$","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.ShortSummer,SkillDescription,,Dealing <font color=\"#5ff5ff\">Cryo Damage</font> to an enemy while [skill]Cold as Ice[-skill] is active grants you a stack of [skill]Short Summer[-skill].<br>You gain increased [skill]Action Skill Cooldown Rate[-skill] and [skill]Shield Recharge Delay[-skill] for each stack of [skill]Short Summer[-skill]. Stacks gradually decay once [skill]Cold as Ice[-skill] ends, and all stacks are lost upon activating [skill]Cold as Ice[-skill] again.","Crocus_Baroness_Streaming,Crocus_Baroness_ColdMoney.Skills.ShortSummer,SkillEffectDefinitions,,((AttributeToModify=AttributeDefinition'D_Attributes.ActiveSkillCooldownResource.ActiveSkillCooldownConsumptionRate',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,