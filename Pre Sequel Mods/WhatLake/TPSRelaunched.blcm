"GD_Prototype_Streaming,GD_Prototype_Skills.explosive.Explosion_CryoExhaustManifold,DamageTypeDef,,WillowDamageTypeDefinition'GD_Ice.DamageType.DmgType_Ice_Status'","GD_Prototype_Streaming,GD_Prototype_Skills.Fragmented.Tripleclocked:AttributePresentationDefinition_4,Description,,<font color=\"#ff6600\">One Shot Wonder:</font> Every shot now consumes your entire Magazine, but multiplies damage by how many fired shots the Magazine would have held.","GD_Prototype_Streaming,GD_Prototype_Skills.Fragmented.Tripleclocked,SkillDescription,,Multiplies the [skill]bonuses[-skill] and [useful]penalties[-useful] of the current [skill]Subroutine[-skill] by up to [skill]three[-skill] based on how few [skill]Frag Stacks[-skill] you currently have. The [skill]Health Subroutines[-skill] always provides [skill][useful]tripled[-useful] Max Health[-skill], regardless of stacks, and [skill]Ammo Regeneration[-skill] values are unaffected..<br>Also, unlocks <font color=\"#ff6600\">ACTION PACKAGE</font> [skill]One Shot Wonder[-skill].","GD_Enforcer_Streaming,GD_Enforcer_Streaming.Melee.BehaviorData_PlayerMeleeAttack_Enforcer,Knockback,,(BaseValueConstant=0.3500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)","GD_Enforcer_Streaming,GD_Enforcer_Streaming.Melee.BehaviorData_PlayerMeleeAttack_Enforcer,Damage,,(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerMeleeDamage',BaseValueScaleConstant=2.5000000)","GD_Enforcer_Streaming,GD_PlayerShared.Behaviors.BehaviorData_PlayerMeleeAttackWithBladedWeapon,Damage,,(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerMeleeDamage',BaseValueScaleConstant=2.50000000)",",GD_Enforcer_Streaming.PlayerEvents_Enforcer:BehaviorProviderDefinition_0.Behavior_CauseDamage_359,DamageSource,,Class'WillowGame.OzWillowDmgSource_Slam'",",GD_Enforcer_Streaming.PlayerEvents_Enforcer:BehaviorProviderDefinition_0.Behavior_CauseDamage_360,DamageSource,,Class'WillowGame.OzWillowDmgSource_Slam'",",GD_Enforcer_Streaming.PlayerEvents_Enforcer:BehaviorProviderDefinition_0.Behavior_CauseDamage_361,DamageSource,,Class'WillowGame.OzWillowDmgSource_Slam'",",GD_Enforcer_Streaming.PlayerEvents_Enforcer:BehaviorProviderDefinition_0.Behavior_CauseDamage_362,DamageSource,,Class'WillowGame.OzWillowDmgSource_Slam'",",GD_Enforcer_Streaming.PlayerEvents_Enforcer:BehaviorProviderDefinition_0.Behavior_CauseDamage_363,DamageSource,,Class'WillowGame.OzWillowDmgSource_Slam'",",GD_Enforcer_Streaming.PlayerEvents_Enforcer:BehaviorProviderDefinition_0.Behavior_CauseDamage_364,DamageSource,,Class'WillowGame.OzWillowDmgSource_Slam'","GD_Enforcer_Streaming,GD_Enforcer_Skills.ActionSkill.RetractDrones,SkillEffectDefinitions,,((AttributeToModify=AttributeDefinition'D_Attributes.ActiveSkillCooldownResource.ActiveSkillCooldownConsumptionRate',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_PostAdd,BaseModifierValue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'GD_Enforcer_Skills.ActionSkill.Att_DroneRetract_CooldownRefundRate',InitializationDefinition=None,BaseValueScaleConstant=0.42500),GradeToStartApplyingEffect=1,PerGradeUpgradeInterval=1,PerGradeUpgrade=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'GD_Enforcer_Skills.ActionSkill.Att_DroneRetract_CooldownRefundRate',InitializationDefinition=None,BaseValueScaleConstant=0.425000),BonusUpgradeList=))","GD_Enforcer_Streaming,GD_Enforcer_Skills.ActionSkill.Skill_AirPower:AttributePresentationDefinition_2,Description,,<font size=\"15\">Saint restores $NUMBER$ of your Max Health / second while active.<br>Wolf is passively healed for [corrosive]10x[-corrosive] this actual value.</font>","GD_Enforcer_Streaming,GD_Enforcer_Skills.ActionSkill.Skill_AirPower:AttributePresentationDefinition_0,Description,,<font size=\"15\">Duration: $NUMBER$ seconds</font>","GD_Enforcer_Streaming,GD_Enforcer_Skills.ActionSkill.Skill_AirPower:AttributePresentationDefinition_3,Description,,<font size=\"15\">Cooldown: $NUMBER$ seconds</font>","GD_Enforcer_Streaming,GD_Enforcer_Skills.ActionSkill.Cooldown_Drone,BaseValue,,(BaseValueConstant=42.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)","GD_Enforcer_Streaming,GD_Enforcer_Skills.ActionSkill.Skill_AirPower,SkillDescription,,<font size=\"14\">[skill]Action Skill[-skill]. Press <StringAliasMap:Action.ActionSkill> to summon [skill]Wolf[-skill] and [skill]Saint[-skill], your trusty combat [skill]Surveyors[-skill]. [skill]Wolf[-skill] will roam and attack enemies, dealing [skill]Kinetic Damage[-skill] that can only be increased through certain skills, while [skill]Saint[-skill] stays close to you and regenerate your [skill]Health[-skill]. [skill]Wolf[-skill] can be damaged by enemies, regnerating [corrosive]10x[-corrosive] the current [skill]Max Health Regeneration[-skill] provided by [skill]Saint[-skill], while [skill]Saint[-skill] does not take damage.<br>Press and hold <StringAliasMap:Action.ActionSkill> to instantly recall them, ending the [skill]Action Skill[-skill] and refunding [skill]Cooldown[-skill] based on remaining [skill]Duration[-skill].</font>","GD_Enforcer_Streaming,GD_Enforcer_Skills.ActionSkill.Skill_SupportDroneHealthRegen,SkillEffectDefinitions,,((AttributeToModify=ResourcePoolAttributeDefinition'D_Attributes.HealthResourcePool.HealthPassiveRegenerationRate',bIncludeDuelingTargets=False,bIncludeSelfAsTarget=False,bOnlyEffectTargetsInRange=False,bExcludeNonPlayerCharacters=False,EffectTarget=TARGET_Self,TargetInstanceDataName=,TargetCriteria=CRITERIA_None,ModifierType=MT_PostAdd,BaseModifierValue=(BaseValueCon