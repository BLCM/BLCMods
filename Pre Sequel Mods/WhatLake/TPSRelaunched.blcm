						</category>
						<category name="Rolling Thunder / Dogfight ">
							<hotfix name="Wilhelm" package="GD_Enforcer_Streaming">
								<code profiles="default">set GD_Enforcer_Skills.HunterKiller.RollingThunder SkillName Dogfight</code>
								<code profiles="default">set GD_Enforcer_Skills.HunterKiller.RollingThunder:AttributePresentationDefinition_1 Description Wolf Bolt Damage per stack: $NUMBER$</code>
