set GD_Cork_Shields.A_Item.Shield_Spike_Ice:AttributePresentationDefinition_5 Description <font size="14"><font color="#9f99ff">Maliwan Rebuttal:</font> Upon taking [skill]Melee Damage[-skill], send out a <font color="#5ff5ff">Cryo</font> [skill]Spike[-skill] to the attacker.<br>[funstat][skill]Spikes[-skill] deal [skill]Melee Damage[-skill] and have a high chance to <font color="#5ff5ff">Freeze</font> non-immune enemies. This [skill]Status Effect[-skill] deals [corrosive]20%[-corrosive] of [skill]Spike Damage[-skill] per tick.</font>
set GD_Cork_Shields.A_Item.Shield_Spike_Ice CustomPresentations (AttributePresentationDefinition'GD_Cork_Shields.A_Item.Shield_Spike_Ice:AttributePresentationDefinition_5',)
set GD_Shields.A_Item.Shield_Spike_Corrosive:AttributePresentationDefinition_7 Description <font size="14"><font color="#9f99ff">Maliwan Rebuttal:</font> Upon taking [skill]Melee Damage[-skill], send out a [corrosive]Corrosive[-corrosive] [skill]Spike[-skill] to the attacker.<br>[funstat][skill]Spikes[-skill] deal [skill]Melee Damage[-skill] and always apply a [corrosive]Corrosive[-corrosive] [skill]Status Effect[-skill] against non-immune enemies. This [skill]Status Effect[-skill] deals [corrosive]20%[-corrosive] of [skill]Spike Damage[-skill] per tick.</font>
set GD_Shields.A_Item.Shield_Spike_Corrosive CustomPresentations (AttributePresentationDefinition'GD_Shields.A_Item.Shield_Spike_Corrosive:AttributePresentationDefinition_7',)
set GD_Shields.A_Item.Shield_Spike_Explosive:AttributePresentationDefinition_0 Description <font size="14"><font color="#9f99ff">Torgue Love Tap:</font> Upon taking [skill]Melee Damage[-skill], send out a [explosive]Explosive[-explosive] [skill]Spike[-skill] to the attacker.<br>[funstat][skill]Spikes[-skill] deal [skill]Melee Damage[-skill] and heavily [skill]flinch[-skill] non-boss targets.</font>
set GD_Shields.A_Item.Shield_Spike_Fire:AttributePresentationDefinition_0 Description <font size="14"><font color="#9f99ff">Maliwan Rebuttal:</font> Upon taking [skill]Melee Damage[-skill], send out a [incendiary]Incendiary[-incendiary] [skill]Spike[-skill] to the attacker.<br>[funstat][skill]Spikes[-skill] deal [skill]Melee Damage[-skill] and always apply an [incendiary]Incendiary[-incendiary] [skill]Status Effect[-skill] against non-immune enemies. This [skill]Status Effect[-skill] deals [corrosive]20%[-corrosive] of [skill]Spike Damage[-skill] per tick.
set GD_Shields.A_Item.Shield_Spike_Fire CustomPresentations (AttributePresentationDefinition'GD_Shields.A_Item.Shield_Spike_Fire:AttributePresentationDefinition_0',)
set GD_Shields.A_Item.Shield_Spike_Shock:AttributePresentationDefinition_5 Description <font size="14"><font color="#9f99ff">Maliwan Rebuttal:</font> Upon taking [skill]Melee Damage[-skill], send out a [shock]Shock[-shock] [skill]Spike[-skill] to the attacker.<br>[funstat][skill]Spikes[-skill] deal [skill]Melee Damage[-skill] and always apply a [shock]Shock[-shock] [skill]Status Effect[-skill] against non-immune enemies. This [skill]Status Effect[-skill] deals [corrosive]20%[-corrosive] of [skill]Spike Damage[-skill] per tick.</font>
set GD_Shields.A_Item.Shield_Spike_Shock CustomPresentations (AttributePresentationDefinition'GD_Shields.A_Item.Shield_Spike_Shock:AttributePresentationDefinition_5',)
set GD_Shields.A_Item.Shield_Juggernaut:AttributePresentationDefinition_3 Description <font size="14"><font color="#9f99ff">Pangolin Shell:</font> High [skill]Capacity[-skill] at the cost of [skill]Max Health[-skill].</font>
set GD_Ma_Shields.A_Item_Unique.Shield_Juggernaut_03_ShieldOfAges:AttributePresentationDefinition_3 Description <font size="14"><font color="#9f99ff">Enhanced Pangolin Shell:</font> High [skill]Capacity[-skill] at the cost of slightly less [skill]Max Health[-skill] than usual.</font>
set GD_Shields.A_Item.Shield_Roid:AttributePresentationDefinition_4 Description <font size="14"><font color="#9f99ff">Scav Adrenaline Rush:</font> When depleted, you deal increased [skill]Melee Damage[-skill].</font>
set GD_Shields.A_Item.Shield_Impact:AttributePresentationDefinition_1 Description <font size="14"><font color="#9f99ff">Tediore Same-Day Delivery:</font> Greatly improved [skill]Shield Recharge Rate[-skill] and [skill]Shield Recharge Delay[-skill].</font>
set GD_Shields.A_Item.Shield_Standard CustomPresentations (AttributePresentationDefinition'GD_Shields.A_Item.Shield_Impact:AttributePresentationDefinition_1',)
